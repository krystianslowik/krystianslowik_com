# HTTP port the server listens on. Optional, default: 3000
PORT=3000

# OpenAI API key. REQUIRED - the server exits at boot when missing.
OPENAI_API_KEY=sk-replace-me

# Chat model for the OpenAI call. Optional, default: gpt-4o
OPENAI_MODEL=gpt-4o

# Comma-separated list of allowed CORS origins. Optional.
# Default: https://krystianslowik.com,http://localhost:4321
ALLOWED_ORIGINS=https://krystianslowik.com,http://localhost:4321

# MySQL connection string for request/response logging. Optional.
# When unset the server boots without a database and logs to stdout only.
# DATABASE_URL=mysql://user:password@host:3306/database

# Global OpenAI-call ceiling per UTC day, across ALL callers. Bounds cost even
# under IP rotation (the per-IP rate limiter can't). Optional, default: 1500.
DAILY_REQUEST_CAP=1500
