---
import { site } from "@data/site";
const { contact, sections } = site;
const [local, domain] = contact.email.split("@");
---

<section id="contact" class="mx-auto max-w-[1280px] scroll-mt-20 px-4 py-16 sm:px-6 sm:py-36">
  <div class="border-t-2 border-fg pt-4" data-perch="rule" data-reveal>
    <h2 class="sr-only">{sections.contact.title}</h2>
    <p class="mono-label text-accent">{sections.contact.index}</p>
    <p class="mt-8 max-w-xl text-xl text-fg-2 sm:text-2xl">{contact.blurb}</p>
    <div class="mt-10">
      <a
        href={`mailto:${contact.email}`}
        class="display block break-all text-[clamp(2rem,7vw,5.5rem)] lowercase leading-[0.95] transition-colors hover:text-accent active:text-accent"
      >{local}<span class="text-accent">@</span>{domain}</a>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-border pt-5">
      <button
        type="button"
        class="mono-label inline-flex min-h-11 items-center border border-fg px-3 transition-colors hover:border-accent hover:text-accent active:bg-accent/10"
        data-copy-btn={contact.email}
      >copy email</button>
      {contact.socials.map((social) => (
        <a href={social.href} target="_blank" rel="me noopener" class="mono-label inline-flex min-h-11 items-center normal-case transition-colors hover:text-accent active:text-accent">{social.label} · {social.handle} →</a>
      ))}
    </div>
  </div>
</section>

<script>
  const onClick = (event: MouseEvent) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>("[data-copy-btn]");
    if (!button) return;
    navigator.clipboard?.writeText(button.dataset.copyBtn || "");
    const previous = button.textContent;
    button.textContent = "copied";
    button.classList.add("text-accent", "border-accent");
    setTimeout(() => {
      button.textContent = previous;
      button.classList.remove("text-accent", "border-accent");
    }, 1400);
  };
  document.addEventListener("click", onClick);
</script>
