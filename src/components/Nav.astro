---
import { site } from "@data/site";
import SlowikMark from "./SlowikMark.astro";
---
<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-[1120px] items-center justify-between gap-3 px-4 py-2 sm:gap-6 sm:px-6 sm:py-3.5">
    <a href="/#content" class="flex items-center gap-2.5" aria-label={site.identity.name}>
      <SlowikMark scale={1} />
      <span class="hidden font-bold tracking-tight sm:inline">{site.identity.name}</span>
    </a>
    <ul class="flex items-center gap-1 sm:gap-2">
      {site.nav.map((n) => (
        <li>
          <a
            href={n.href}
            class:list={[
              "mono-label inline-block px-1.5 py-3 transition-colors hover:text-accent active:text-accent sm:px-2 sm:py-2.5",
              n.label === "chat" && "text-accent",
            ]}
          >{n.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
