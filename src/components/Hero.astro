---
import { site } from "@data/site";
const { identity, manual, slowik } = site;
const nameParts = identity.name.split(" ");
const surname = nameParts.pop();
const forename = nameParts.join(" ");
const tape = manual.marquee.join("  ·  ");
---

<section id="content" class="flex flex-col pt-20 sm:pt-24">
  <div class="mx-auto flex w-full max-w-[1280px] flex-1 flex-col justify-start gap-2 px-4 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-4 border-t-2 border-fg pt-2">
      <p class="mono-label text-fg">{manual.docNo} · cover / identity</p>
      <p class="mono-label hidden sm:block">{manual.effective} · {manual.sheet}</p>
    </div>

    <div class="py-8 sm:py-10 lg:py-8">
      <div class="min-w-0">
        <h1 class="display text-[clamp(3.5rem,17vw,11rem)] uppercase leading-[0.88] sm:text-[clamp(3.7rem,15vw,14rem)] lg:text-[clamp(8rem,17vw,14rem)]">
          {forename}<br />
          <span data-perch="name" class="inline-block">{surname}</span>
        </h1>

        <div class="mt-6 border-t border-border pt-5 sm:mt-7">
          <div>
            <p class="font-serif text-lg italic text-fg-2 sm:text-xl">
              <span lang="pl">słowik</span> <span class="not-italic text-muted">/ˈswɔ·vik/</span>, Polish for "nightingale"
            </p>
            <p class="mt-4 max-w-2xl text-lg leading-snug sm:mt-5 sm:text-2xl">{identity.role}</p>
            <p class="mt-4 border-l-2 border-accent pl-4 font-serif text-base italic text-fg-2 sm:mt-5 sm:text-lg">{identity.manifesto}</p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 sm:mt-7 sm:gap-x-5 sm:gap-y-2" data-reveal>
          <span class="mono-label text-fg">ask the bird:</span>
          {slowik.chips.slice(0, 3).map((chip) => (
            <button
              type="button"
              data-slowik-ask={chip}
              class="mono-label inline-flex min-h-11 items-center transition-colors before:content-['['] after:content-[']'] hover:text-accent active:text-accent"
            >{chip}</button>
          ))}
          <a href="#chat" class="mono-label inline-flex min-h-11 items-center text-accent transition-colors hover:text-accent-hi">press / to ask your own →</a>
        </div>
      </div>

    </div>
  </div>

  <div class="overflow-hidden border-y-2 border-fg bg-accent py-2 text-bg">
    <div class="tape-track font-mono text-xs uppercase tracking-[0.16em]">
      <span class="shrink-0 pr-12">{tape}</span>
      <span class="shrink-0 pr-12" aria-hidden="true">{tape}</span>
    </div>
  </div>
</section>
