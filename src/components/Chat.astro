---
import { site } from "@data/site";
import SlowikChat from "./SlowikChat.svelte";
const { slowik, sections } = site;
---

<section id="chat" class="scroll-mt-20 border-y-2 border-fg bg-elevated py-10 sm:py-28">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-5" data-reveal>
      <div>
        <p class="mono-label text-accent">{sections.chat.index}</p>
        <h2 class="display mt-3 text-[clamp(2.8rem,8vw,7rem)] uppercase leading-[0.85]">{sections.chat.title}</h2>
      </div>
      {sections.chat.meta && <p class="mono-label pb-1">{sections.chat.meta}</p>}
    </div>

    <div class="relative mt-6 border-2 border-fg bg-bg p-3 sm:mt-12 sm:p-7" data-reveal>
      <span aria-hidden="true" class="absolute left-2 top-2 h-1.5 w-1.5 rounded-full bg-fg"></span>
      <span aria-hidden="true" class="absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-fg"></span>
      <span aria-hidden="true" class="absolute bottom-2 left-2 h-1.5 w-1.5 rounded-full bg-fg"></span>
      <span aria-hidden="true" class="absolute bottom-2 right-2 h-1.5 w-1.5 rounded-full bg-fg"></span>

      <div class="hazard" aria-hidden="true"></div>
      <div class="grid gap-4 border-b border-border py-5 sm:grid-cols-[150px_1fr]">
        <p class="mono-label text-accent">channel ks-01</p>
        <p class="max-w-2xl text-fg-2">{slowik.intro}</p>
      </div>

      <SlowikChat client:only="svelte" slowik={slowik} />
      <noscript><p class="mono-label">the słowik needs JavaScript. email me at {site.contact.email}.</p></noscript>
    </div>
  </div>
</section>
