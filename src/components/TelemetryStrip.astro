---
import { site } from "@data/site";
const s = site.status;
---

<!-- Telemetry strip: labeled key/value fields, NO literal separators — chips are
     atomic (whitespace-nowrap) so nothing can orphan on wrap. Below sm it is a
     one-line swipeable tape (edge-fade hints at more, availability pinned first);
     from sm it wraps tidily and availability is right-aligned. The outer div is
     the companion bird's perch — keep data-perch on it. -->
<div class="border-b border-border" data-perch="strip">
  <div
    class="mono-label mx-auto flex max-w-[1120px] flex-nowrap items-center gap-x-6 gap-y-1.5 overflow-x-auto py-2.5 pl-4 pr-10 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [mask-image:linear-gradient(90deg,#000,#000_calc(100%-32px),transparent)] sm:flex-wrap sm:overflow-visible sm:px-6 sm:[mask-image:none]"
  >
    {s.availability && (
      <span class="-order-1 inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-accent sm:order-1 sm:ml-auto">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent motion-safe:animate-[pulse_3s_ease-in-out_infinite]"></span>
        {s.availability}
      </span>
    )}
    {
      s.fields.map((f) => (
        <span class="shrink-0 whitespace-nowrap">
          {f.k}
          <span class:list={["text-fg-2", f.k && "ml-1.5"]}>
            {f.live && <span data-clock class="mr-1">--:--:--</span>}{f.v}
          </span>
        </span>
      ))
    }
  </div>
</div>

<script>
  const fmt = () =>
    new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit", minute: "2-digit", second: "2-digit",
      hour12: false, timeZone: "Europe/Berlin",
    }).format(new Date());
  const tick = () =>
    document.querySelectorAll("[data-clock]").forEach((el) => (el.textContent = fmt()));
  tick();
  setInterval(tick, 1000);
  document.addEventListener("astro:page-load", tick);
</script>
