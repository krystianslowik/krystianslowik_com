---
import { site } from "@data/site";
import SectionHeading from "./SectionHeading.astro";
const { experience } = site;
---
<section id="experience" class="mx-auto max-w-[1120px] px-4 py-14 sm:px-6 sm:py-20">
  <SectionHeading index="03" title="Experience" meta="git log --first-parent" />
  <ol class="space-y-4 font-mono text-sm" data-reveal>
    {experience.items.map((e) => (
      <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <span class="text-accent">{e.hash}</span>
        <span class="tabular-nums text-muted">{e.date}</span>
        <span class="text-fg-2" data-perch={e.head ? "rule" : undefined}>
          {e.role}{e.head && <span class="ml-2 text-accent">— HEAD</span>}
        </span>
      </li>
    ))}
  </ol>
</section>
