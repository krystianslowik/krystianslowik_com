---
import { getCollection } from "astro:content";
import SectionHeading from "./SectionHeading.astro";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const ym = (d: Date) => d.toISOString().slice(0, 7);
---
<section id="writing" class="mx-auto max-w-[1120px] px-4 py-14 sm:px-6 sm:py-20">
  <SectionHeading index="04" title="Writing" />
  <ul class="divide-y divide-border" data-reveal>
    {posts.map((p) => (
      <li>
        <a href={`/writing/${p.id}/`} class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-6">
          <div>
            <h3 class="font-serif text-xl italic transition-colors group-hover:text-accent group-active:text-accent" data-perch="rule">{p.data.title}</h3>
            <p class="mt-2 max-w-xl text-fg-2">{p.data.blurb}</p>
          </div>
          <span class="mono-label whitespace-nowrap">
            {ym(p.data.pubDate)}{p.data.readingTime && ` · ${p.data.readingTime}`}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="mono-label mt-6">
    <a href="/writing/" class="inline-block py-1 transition-colors hover:text-accent active:text-accent">all notes →</a>
  </p>
</section>
