---
import { site } from "@data/site";
import SectionHeading from "./SectionHeading.astro";
const { work } = site;
---
<section id="work" class="mx-auto max-w-[1120px] px-4 py-14 sm:px-6 sm:py-20">
  <SectionHeading index="02" title={work.lead} meta={work.count} />
  <div class="space-y-14">
    {work.items.map((item) => (
      <article class="border-t border-border pt-8" data-reveal data-perch="rule">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <div class="flex items-baseline gap-4">
            <span class="mono-label text-muted">{item.index}</span>
            <h3 class="text-xl font-bold tracking-tight">{item.title}</h3>
          </div>
          <span class="mono-label whitespace-nowrap text-accent">{item.metric}</span>
        </div>
        <p class="mt-4 max-w-2xl text-fg-2">{item.blurb}</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {item.tags.map((t) => (
            <li class="mono-label rounded-sm border border-border px-2 py-1 text-muted">{t}</li>
          ))}
        </ul>
        <div class="mt-8 max-w-2xl space-y-6 border-l border-border pl-4 sm:pl-6">
          <div><p class="mono-label">problem</p><p class="mt-1 text-fg-2">{item.problem}</p></div>
          <div><p class="mono-label">action</p><p class="mt-1 text-fg-2">{item.action}</p></div>
          <div><p class="mono-label">outcome</p><p class="mt-1 text-fg-2">{item.outcome}</p></div>
          <div>
            <p class="mono-label text-accent">what i'd do differently</p>
            <p class="mt-1 text-fg-2">{item.whatIdDoDifferently}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
