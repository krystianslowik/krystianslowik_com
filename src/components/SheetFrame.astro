---
import { site } from "@data/site";
import SlowikMark from "./SlowikMark.astro";
const { identity, manual, status, colophon } = site;
const location = status.location;
---

<!-- Fixed marginalia: this is the sheet's frame, not a navigation bar. The companion renders at z-35 and passes beneath these tiles; it clips its hit box against [data-frame-tile]. -->
<header data-sheet-frame class="pointer-events-none fixed inset-x-0 top-0 z-40 px-4 pt-3 sm:px-6 sm:pt-5">
  <div class="mx-auto flex max-w-[1280px] items-start justify-between gap-3">
    <a href="/#content" class="pointer-events-auto flex min-h-11 min-w-11 items-center justify-center gap-3 frame-tile px-2 py-2 sm:min-w-0 sm:justify-start" data-frame-tile aria-label={identity.name}>
      <SlowikMark scale={1} />
      <span class="hidden leading-none sm:block">
        <span class="block text-xs font-bold uppercase tracking-tight">{identity.name}</span>
        <span class="mono-label mt-1 block text-[9px]">{manual.docNo}</span>
      </span>
    </a>
    <nav class="pointer-events-auto" aria-label="Page index">
      <ul class="flex items-center gap-0.5 frame-tile px-1 sm:gap-2 sm:px-2" data-frame-tile>
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "mono-label inline-block px-1.5 py-3 transition-colors hover:text-accent active:text-accent sm:px-2",
                item.label === "chat" && "text-accent",
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<div class="pointer-events-none fixed inset-x-0 bottom-0 z-40 hidden px-6 pb-5 sm:block">
  <div class="mono-label normal-case mx-auto flex max-w-[1280px] items-end justify-between gap-6">
    <p class="frame-tile px-2 py-1" data-frame-tile>
      {location} · <span data-clock>--:--:--</span> <span data-zone>--</span>
    </p>
    <p class="frame-tile px-2 py-1 text-right" data-frame-tile>
      {manual.revision} · {colophon.commit}
    </p>
  </div>
</div>

<script>
  const formatter = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit", minute: "2-digit", second: "2-digit",
      hour12: false, timeZone: "Europe/Berlin", timeZoneName: "short",
    });
  const tick = () => {
    const parts = formatter.formatToParts(new Date());
    const time = parts.filter((part) => ["hour", "minute", "second", "literal"].includes(part.type)).map((part) => part.value).join("").trim();
    const zone = parts.find((part) => part.type === "timeZoneName")?.value ?? "";
    document.querySelectorAll("[data-clock]").forEach((el) => (el.textContent = time));
    document.querySelectorAll("[data-zone]").forEach((el) => (el.textContent = zone));
  };
  tick();
  setInterval(tick, 1000);
  document.addEventListener("astro:page-load", tick);
</script>
