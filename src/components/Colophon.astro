---
import { site } from "@data/site";
const { colophon } = site;
---

<footer id="colophon" class="border-t-2 border-fg bg-elevated" data-perch="footer">
  <div class="mx-auto max-w-[1280px] px-4 py-12 sm:px-6 sm:py-16">
    <dl class="grid grid-cols-2 border-l border-t border-fg sm:grid-cols-4" data-reveal>
      {colophon.titleBlock.map((cell) => (
        <div class="border-b border-r border-fg p-4 sm:p-5">
          <dt class="mono-label text-accent">{cell.k}</dt>
          <dd class="mono mt-2 text-xs leading-relaxed text-fg-2">{cell.v}</dd>
        </div>
      ))}
    </dl>

    <div class="mono-label mt-8 border-t border-border pt-5">
      <span>{colophon.copyright} · {colophon.version} · <span class="text-accent">{colophon.commit}</span></span>
    </div>
  </div>
</footer>
