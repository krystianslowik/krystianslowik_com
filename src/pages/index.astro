---
import Base from "../layouts/Base.astro";
import SheetFrame from "@components/SheetFrame.astro";
import Hero from "@components/Hero.astro";
import Work from "@components/Work.astro";
import Chat from "@components/Chat.astro";
import Record from "@components/Record.astro";
import Contact from "@components/Contact.astro";
import Colophon from "@components/Colophon.astro";
import { homeSchema } from "@lib/schema";
import { site } from "@data/site";
---
<Base schema={homeSchema(site.meta.title)}>
  <SheetFrame />
  <main>
    <Hero />
    <Work />
    <Chat />
    <Record />
    <Contact />
  </main>
  <Colophon />
</Base>

<script>
  // Scroll reveals via IntersectionObserver — the CSS (html.reveal-armed) does
  // the hiding; this just adds .revealed as elements enter. astro:page-load fires
  // on first load AND after every ClientRouter swap.
  function setup() {
    if (!document.documentElement.classList.contains("reveal-armed")) return; // reduced motion / not armed
    const els = [...document.querySelectorAll<HTMLElement>("[data-reveal]:not(.revealed)")];
    if (!els.length) return;

    const io = new IntersectionObserver(
      (entries, obs) => {
        // stagger elements that enter together (e.g. everything above the fold at load)
        let i = 0;
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          el.style.transitionDelay = `${Math.min(i++, 6) * 70}ms`;
          el.classList.add("revealed");
          obs.unobserve(el);
        }
      },
      { rootMargin: "0px 0px -10% 0px" },
    );
    els.forEach((el) => io.observe(el));

    // safety: reveal anything still hidden shortly after load
    setTimeout(() => els.forEach((el) => el.classList.add("revealed")), 2000);
  }

  document.addEventListener("astro:page-load", setup);
</script>
