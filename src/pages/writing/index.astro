---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "@components/Nav.astro";
import { site } from "@data/site";
import { writingIndexSchema } from "@lib/schema";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const ym = (d: Date) => d.toISOString().slice(0, 7);
const schema = writingIndexSchema(
  posts.map((p) => ({
    title: p.data.title,
    url: new URL(`/writing/${p.id}/`, site.meta.url).href,
    description: p.data.blurb,
    datePublished: p.data.pubDate.toISOString(),
  })),
);
---
<Base title="Writing — Krystian Słowik" description="Notes on keeping systems boring: postmortems, homelab k8s, and the craft of reliability." schema={schema}>
  <Nav />
  <main id="content" class="mx-auto max-w-[840px] px-4 py-14 sm:px-6 sm:py-20">
    <header class="mb-8 flex items-baseline gap-4 sm:mb-10">
      <span class="mono-label shrink-0 text-accent">[04]</span>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Writing</h1>
    </header>
    <ul class="divide-y divide-border">
      {posts.map((p) => (
        <li>
          <a href={`/writing/${p.id}/`} class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-6">
            <div>
              <h2 class="font-serif text-xl italic transition-colors group-hover:text-accent group-active:text-accent">{p.data.title}</h2>
              <p class="mt-2 max-w-xl text-fg-2">{p.data.blurb}</p>
            </div>
            <span class="mono-label whitespace-nowrap">
              <time datetime={p.data.pubDate.toISOString().slice(0, 10)}>{ym(p.data.pubDate)}</time>{p.data.readingTime && ` · ${p.data.readingTime}`}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mono-label mt-10">
      <a href="/" class="inline-block py-1 transition-colors hover:text-accent active:text-accent">← back to the site</a>
    </p>
  </main>
</Base>
