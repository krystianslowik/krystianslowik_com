---
import Base from "../../layouts/Base.astro";
import SheetFrame from "@components/SheetFrame.astro";
import { site } from "@data/site";
import { writingIndexSchema } from "@lib/schema";
import { publishedPosts } from "@lib/writing";

const posts = await publishedPosts();
const ym = (d: Date) => d.toISOString().slice(0, 7);
const schema = writingIndexSchema(
  posts.map((p) => ({
    title: p.data.title,
    url: new URL(`/writing/${p.id}/`, site.meta.url).href,
    description: p.data.blurb,
    datePublished: p.data.pubDate.toISOString(),
  })),
);
---
<Base title={site.writing.title} description={site.writing.description} schema={schema}>
  <SheetFrame />
  <main id="content" class="mx-auto max-w-[840px] px-4 pb-16 pt-28 sm:px-6 sm:pb-20 sm:pt-32">
    <header class="mb-8 flex items-baseline justify-between gap-4 border-b-2 border-fg pb-2.5 sm:mb-10">
      <h1 class="display text-2xl uppercase tracking-[0.02em] sm:text-3xl">
        <span class="mono-label mr-3 font-normal text-accent">archive /</span>{site.writing.lead}
      </h1>
      <span class="mono-label whitespace-nowrap">field notes, signed</span>
    </header>
    <ul class="divide-y divide-border">
      {posts.map((p) => (
        <li>
          <a href={`/writing/${p.id}/`} class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-6">
            <div>
              <h2 class="font-serif text-xl italic transition-colors group-hover:text-accent group-active:text-accent">{p.data.title}</h2>
              <p class="mt-2 max-w-xl text-fg-2">{p.data.blurb}</p>
            </div>
            <span class="mono-label whitespace-nowrap">
              <time datetime={p.data.pubDate.toISOString().slice(0, 10)}>{ym(p.data.pubDate)}</time>{p.data.readingTime && ` · ${p.data.readingTime}`}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mono-label mt-10">
      <a href="/" class="inline-block py-1 transition-colors hover:text-accent active:text-accent">← back to the site</a>
    </p>
  </main>
</Base>
