---
import Base from "../layouts/Base.astro";
import SheetFrame from "@components/SheetFrame.astro";
---
<Base title="404 | page not found" description="This page does not exist." noindex>
  <SheetFrame />
  <main id="content" class="mx-auto flex min-h-screen max-w-[1120px] flex-col justify-center px-4 py-24 sm:px-6">
    <canvas id="slowik-404" class="mb-6 block self-start" style="image-rendering: pixelated;" aria-hidden="true"></canvas>
    <p class="mono-label text-accent">404</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">Page not found</h1>
    <p class="mt-3 text-fg-2">Nothing lives at this address.</p>
    <a href="/" class="mono-label mt-8 inline-block py-3 transition-colors hover:text-accent active:text-accent">← back home</a>
  </main>

  <script>
    import { mountPerched } from "../lib/slowik";
    const cv = document.getElementById("slowik-404") as HTMLCanvasElement | null;
    if (cv) mountPerched(cv, 2).setState("sleep");
  </script>
</Base>
